// Prisma DB Push workflow test

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  vehicleNo    String
  model        String?
  manufacturer String?
  year         Int?
  status       String?
  createdAt    DateTime
  updatedAt    DateTime

  @@map("vehicles")
}

model Driver {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  licenseNo String?
  phone     String?
  createdAt DateTime
  updatedAt DateTime

  @@map("drivers")
}

model VehicleDriver {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId    String
  driverId     String
  assignedAt   DateTime?
  unassignedAt DateTime?

  @@index([vehicleId])
  @@index([driverId])
  @@map("vehicleDrivers")
}

model DrivingRecord {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId String
  driverId  String?
  startedAt DateTime
  endedAt   DateTime?
  distance  Float?
  duration  Int?

  @@index([vehicleId])
  @@index([driverId])
  @@index([startedAt])
  @@map("drivingRecords")
}

model AnomalyEvent {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId       String
  drivingRecordId String?
  type            String
  severity        String
  occurredAt      DateTime
  value           Float?
  description     String?

  @@index([vehicleId])
  @@index([drivingRecordId])
  @@index([occurredAt])
  @@map("anomalyEvents")
}